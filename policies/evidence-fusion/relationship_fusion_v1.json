{
  "policy_id": "relationship-fusion-v1",
  "version": "1.0",
  "subject_kind": "RELATIONSHIP",
  "status": "UNCALIBRATED",
  "score_semantics": "UNCALIBRATED_DECISION_SCORE",
  "automation": {"enabled": false, "auto_accept": false, "auto_reject": false, "requires_g5": true},
  "normalization_rules": [
    {"rule_id": "bounded-01", "metric_names": ["inclusion_coverage", "orphan_ratio", "target_uniqueness", "declared_foreign_key", "quality_ratio"], "method": "identity_v1", "version": "1"},
    {"rule_id": "compatibility-01", "metric_names": ["type_compatibility"], "method": "compatibility_strength_v1", "version": "1"},
    {"rule_id": "matcher-rank", "metric_names": ["matcher_rank"], "method": "ordinal_presence_v1", "version": "1"},
    {"rule_id": "qualitative-only", "metric_names": ["semantic_hypothesis", "domain_assertion", "low_cardinality_risk"], "method": "qualitative_only_v1", "version": "1"}
  ],
  "scoring_dimensions": [
    {"dimension_id": "inclusion", "metric_names": ["inclusion_coverage", "orphan_ratio"], "weight": 1.0, "normalization_rule_id": "bounded-01", "dependency_group": "inclusion", "required": true},
    {"dimension_id": "target_uniqueness", "metric_names": ["target_uniqueness"], "weight": 1.0, "normalization_rule_id": "bounded-01", "dependency_group": "target_uniqueness", "required": true},
    {"dimension_id": "type_compatibility", "metric_names": ["type_compatibility"], "weight": 0.75, "normalization_rule_id": "compatibility-01", "dependency_group": "type_compatibility", "required": true},
    {"dimension_id": "declared_constraint", "metric_names": ["declared_foreign_key"], "weight": 1.0, "normalization_rule_id": "bounded-01", "dependency_group": "declared_constraint", "required": false}
  ],
  "band_policy": [
    {"band": "HIGH", "minimum": 0.75},
    {"band": "MEDIUM", "minimum": 0.4, "maximum": 0.75},
    {"band": "LOW", "maximum": 0.4}
  ],
  "conflict_rules": [
    {"rule_id": "semantic-structural", "conflict_type": "SEMANTIC_STRUCTURAL_CONFLICT", "semantics": "semantic support plus relevant structural contradiction", "eligible_metric_names": ["orphan_ratio", "target_uniqueness", "type_compatibility", "quality_issue:DECLARED_REFERENTIAL_INTEGRITY_VIOLATION", "quality_issue:DECLARED_REFERENTIAL_INTEGRITY_INCONCLUSIVE", "quality_issue:UNIQUE_VALUES_VIOLATION", "quality_issue:EXPECTED_PRIMITIVE_TYPE_MISMATCH"], "eligible_families": ["DEPENDENCY", "QUALITY", "SCHEMA_MATCHING"]},
    {"rule_id": "declared-data", "conflict_type": "DECLARED_DATA_CONFLICT", "semantics": "declared relationship plus observed relationship-integrity contradiction", "eligible_metric_names": ["orphan_ratio", "target_uniqueness", "type_compatibility", "quality_issue:DECLARED_REFERENTIAL_INTEGRITY_VIOLATION", "quality_issue:DECLARED_REFERENTIAL_INTEGRITY_INCONCLUSIVE", "quality_issue:UNIQUE_VALUES_VIOLATION", "quality_issue:EXPECTED_PRIMITIVE_TYPE_MISMATCH"], "eligible_families": ["DEPENDENCY", "QUALITY", "SCHEMA_MATCHING"]},
    {"rule_id": "type-semantic", "conflict_type": "TYPE_SEMANTIC_CONFLICT", "semantics": "incompatible type plus semantic or matcher support", "eligible_metric_names": ["type_compatibility"], "eligible_families": ["DEPENDENCY", "SCHEMA_MATCHING"]},
    {"rule_id": "sample-full", "conflict_type": "SAMPLE_FULLSCAN_CONFLICT", "threshold": 0.5, "semantics": "same metric disagrees across compatible sampled/full scope"},
    {"rule_id": "multiple-target", "conflict_type": "MULTIPLE_TARGET_AMBIGUITY", "semantics": "competing target candidate changes applicability"}
  ],
  "required_producer_families": ["PROFILE", "DEPENDENCY", "QUALITY"],
  "cross_source_mapping_requires_schema_matching": true
}
